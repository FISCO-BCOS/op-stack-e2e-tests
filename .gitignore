# --- e2e runtime/local artifacts ---
__pycache__/
*.pyc
*.log

# --- t8n reference vectors: regenerated on demand (see
# opstack-executor/tests/t8n/generator/regen.sh) and by CI. Only the
# non-generated contract files (manifest.txt, *.md, SHA256SUMS) and the
# generator itself are tracked. ---
opstack-executor/tests/t8n/cases/
opstack-executor/tests/t8n/vectors/*.json
# ladder mode (D1g) writes a per-vector checksums file beside the vectors; it is a
# generation by-product with no reader (unlike golden/engine/SHA256SUMS, which is a
# tracked contract), so it stays out of the tree.
opstack-executor/tests/t8n/vectors/SHA256SUMS
# P3-2 exceptions: the real-derivation devnet snapshot is a registered INPUT (a
# one-shot chainexport export of the real devnet chain, replayed as-is), not a
# regen.sh product -- it is tracked like the other non-generated contracts, together
# with the vectors/SHA256SUMS contract that pins its bytes (the ladder mode upserts
# only its own stem's line in that file and preserves the devnet lines).
!opstack-executor/tests/t8n/vectors/devnet_*.json
!opstack-executor/tests/t8n/vectors/SHA256SUMS
opstack-executor/tests/t8n/golden/engine/*.golden.json
opstack-executor/tests/t8n/golden/engine/chained/*.json
opstack-executor/tests/t8n/golden/engine/getpayload/*.json
opstack-executor/tests/t8n/matrix/caps.json
opstack-executor/tests/t8n/matrix/engine_api_windows.json

# chainexport build product (rebuild via tools/devnet/chainexport/build.sh)
tools/devnet/chainexport/chainexport.bin
